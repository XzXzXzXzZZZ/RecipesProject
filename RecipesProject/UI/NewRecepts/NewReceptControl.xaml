<UserControl x:Class="RecipesProject.UI.NewRecepts.NewReceptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit">

    <!--скролл -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="White" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Добавление нового рецепта" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Название блюда:" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox" Height="35" Padding="5" FontSize="14"/>

                <TextBlock Text="Описание:" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox" Height="35" Padding="5" FontSize="14"/>

                <StackPanel Orientation="Horizontal" Margin="0, 10">
                    <TextBlock Text="Сложность:" FontSize="14" Margin="0,5,10,5"/>
                    <toolkit:IntegerUpDown x:Name="DifficultyIntegerUpDown" Minimum="0" Maximum="5" Value="0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0, 10">
                    <TextBlock Text="Количество порций:" FontSize="14" Margin="0,5,10,5"/>
                    <toolkit:IntegerUpDown x:Name="ServingsIntegerUpDown"  Minimum="1" Maximum="100" Value="4" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="Ингредиенты:" 
                               FontSize="14" 
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!--Текстбокс для поиска -->
                    <TextBox x:Name="SearchIngredientTextBox" 
                             Grid.Column="1"
                             Width="200"
                             Height="30"
                             Padding="5" 
                             FontSize="12"
                             VerticalAlignment="Center"
                             GotFocus="SearchIngredientTextBox_GotFocus"
                             LostFocus="SearchIngredientTextBox_LostFocus"/>
                </Grid>

                <!--текстбокс для ингредиентов -->
                <TextBox x:Name="IngredientsTextBox" 
                         Height="150" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         Padding="5" 
                         FontSize="14"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <Image x:Name="ViewImage"/>
            <Button x:Name="AddImage" Grid.Row="2" Content="Добавить фото" Height="20" Margin="0,200,0,0" Grid.RowSpan="3" VerticalAlignment="Top" Click="AddImage_Click"/>

            <Button x:Name="GoToStepsButton"
                    Grid.Row="5"
                    Content="➡ Перейти к созданию шагов" 
                    Height="45" 
                    Width="200"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,20"
                    Background="LightBlue"
                    Cursor="Hand"
                    Click="GoToStepsButton_Click"/>

            <Rectangle Grid.Row="6" Height="20"/>
        </Grid>

    </ScrollViewer>
</UserControl>