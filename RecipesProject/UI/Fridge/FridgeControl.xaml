<UserControl x:Class="RecipesProject.UI.Fridge.FridgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="IngredientToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFA0A0A0"/>
                    <Setter Property="BorderBrush" Value="#FF808080"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFC0C0C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivePaginationButtonStyle" TargetType="Button" BasedOn="{StaticResource PaginationButtonStyle}">
            <Setter Property="Background" Value="#FFA0A0A0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Стиль для кнопок действий -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD0D0D0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0"
                       Text="Холодильник - выберите ингредиенты" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Margin="10,10,10,15"
                       HorizontalAlignment="Center"/>

            <!-- подсказка-->
            <TextBlock Grid.Row="1"
                       Text="Нажмите на ингредиенты, которые есть у вас в холодильнике"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="10,0,10,15"
                       HorizontalAlignment="Center"/>

            <!-- окошко с ингредиентами (текущая страница) -->
            <WrapPanel Grid.Row="2" 
                       x:Name="IngredientsPanel"
                       Margin="10" 
                       HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,10,0,10">
                <Button x:Name="PrevButton"
                        Content="◀"
                        Style="{StaticResource PaginationButtonStyle}"
                        Click="PrevButton_Click"/>

                <WrapPanel x:Name="PagesPanel" 
                           HorizontalAlignment="Center"/>

                <Button x:Name="NextButton"
                        Content="▶"
                        Style="{StaticResource PaginationButtonStyle}"
                        Click="NextButton_Click"/>
            </StackPanel>

            <!-- Постоянные продукты -->
            <Border Grid.Row="4"
                    Background="#FFF9F9F9"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="10,5,10,5"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок и кнопка добавления -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Постоянные продукты" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FF555555"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="AddProductBtn"
                                Content="➕ Добавить"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="100"
                                Margin="15,0,0,0"
                                Click="AddProductBtn_Click"/>
                    </StackPanel>

                    <!-- Список постоянных продуктов -->
                    <WrapPanel x:Name="ConstantProductsPanel" Grid.Row="1" Margin="0,5,0,5">
                        <TextBlock x:Name="EmptyConstantText"
                                   Text="Нет постоянных продуктов. Нажмите 'Добавить'"
                                   FontSize="14"
                                   Foreground="Gray"
                                   Margin="5"
                                   Visibility="Visible"/>
                    </WrapPanel>

                    <!-- Панель для добавления продукта (скрыта по умолчанию) -->
                    <Border x:Name="AddProductPanel"
                            Grid.Row="2"
                            Background="White"
                            BorderBrush="#FFCCCCCC"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="NewProductNameTextBox"
                                Grid.Row="0" Grid.Column="0"
                                Width="200"
                                Height="35"
                                Padding="5"
                                FontSize="14"
                                Margin="0,0,10,5"
                                VerticalAlignment="Center"
                                ToolTip="Название продукта"/>

                    <CheckBox x:Name="IsPermanentCheckBox"
                                Grid.Row="0" Grid.Column="1"
                                Content="Постоянный"
                                FontSize="14"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                IsChecked="True"/>

                    <Button x:Name="ConfirmAddBtn"
        Grid.Row="0" Grid.Column="2"
                            Content="✅ Добавить"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="100"
                            Click="ConfirmAddBtn_Click"/>

                    <Button x:Name="CancelAddBtn"
                            Grid.Row="1" Grid.Column="2"
                            Content="❌ Отмена"
                            Style="{StaticResource ActionButtonStyle}"
                            Width="100"
                            Margin="0,5,0,0"
                            Click="CancelAddBtn_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Подходящие рецепты -->
            <Border Grid.Row="5"
                    Background="#FFF9F9F9"
                    BorderBrush="#FFE0E0E0"
                    BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0"
                    Margin="10,5,10,10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#FFF0F0F0"
                            CornerRadius="10,10,0,0"
                            Padding="10,5">
                        <TextBlock Text="Подходящие рецепты:"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF555555"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="RecipesContainer"
                                Grid.Row="1"
                                Margin="10"
                                VerticalAlignment="Top">

                        <TextBlock x:Name="EmptyRecipesText"
                                   Text="Выберите ингредиенты, чтобы увидеть подходящие рецепты..."
                                   FontSize="14"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,20"
                                   Visibility="Visible"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Кнопка удаления рецепта -->
            <StackPanel Grid.Row="6" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,5,0,15">
                <Button x:Name="DeleteRecipeBtn"
                        Content="🗑 Удалить выбранный рецепт"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#FFFF6B6B"
                        Foreground="White"
                        Width="200"
                        Click="DeleteRecipeBtn_Click"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>